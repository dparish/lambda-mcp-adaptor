{
  "name": "lambda-mcp-adaptor",
  "version": "1.0.0",
  "description": "An MCP (Model Context Protocol) server SDK for AWS serverless architecture with official SDK-like API design",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && npm run typecheck:tests",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.mjs --external:zod",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js --external:zod",
    "build:types": "tsc -p tsconfig.json && cp src/mcp-spec.d.ts dist/mcp-spec.d.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "dev": "node examples/basic-server.mjs",
    "lint": "eslint src/**/*.{js,ts,mjs} --fix",
    "lint:check": "eslint src/**/*.{js,ts,mjs}",
    "format": "prettier --write src/**/*.{js,ts,mjs,json,md}",
    "format:check": "prettier --check src/**/*.{js,ts,mjs,json,md}"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aws-lambda",
    "serverless",
    "zod",
    "type-safety",
    "json-rpc",
    "ai",
    "llm",
    "tools"
  ],
  "author": "moritalous",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moritalous/lambda-mcp-adaptor.git"
  },
  "bugs": {
    "url": "https://github.com/moritalous/lambda-mcp-adaptor/issues"
  },
  "homepage": "https://github.com/moritalous/lambda-mcp-adaptor#readme",
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/aws-lambda": "^8.10.137",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "esbuild": "^0.19.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.2.0",
    "json-schema": "^0.4.0",
    "prettier": "^3.5.3",
    "tsdown": "^0.20.0-beta.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^2.1.8",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
